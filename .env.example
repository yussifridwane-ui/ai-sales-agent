# Database — SQLite for local/demo. Use PostgreSQL in production:
# DATABASE_URL="postgresql://user:pass@localhost:5432/aisales?schema=public"
DATABASE_URL="file:./dev.db"

# Auth
AUTH_SECRET="change-me-to-a-long-random-string-min-32-chars"
APP_URL="http://localhost:3000"
ALLOWED_ORIGINS=""
ENFORCE_ADMIN_MFA="1"

# AI provider (optional — demo engine is used when empty)
AI_PROVIDER="openai"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"
AI_BASE_URL="https://api.openai.com/v1"

# Payments (optional — demo checkout when empty)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# WhatsApp Cloud API (optional)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="aisales-verify"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# Instagram / Meta (optional)
META_APP_ID=""
META_APP_SECRET=""
INSTAGRAM_VERIFY_TOKEN="aisales-ig-verify"

# Email (optional — console provider when empty)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="AI Sales Agent <noreply@example.com>"

# Object storage (optional — local /public/uploads when empty)
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Encryption for stored integration credentials
CREDENTIALS_ENCRYPTION_KEY="change-me-32-byte-key-please!!!!"
